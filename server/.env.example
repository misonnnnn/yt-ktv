PORT=4000
# Comma-separated OK. www / non-www variants are added automatically.
CLIENT_URL=http://localhost:3000,https://tarasing.online,https://www.tarasing.online

# Use one Google Cloud project for YouTube API (production). Do not spread keys across projects.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Songs shown before a search. Restart the server after changing this.
# youtube (default): search YouTube for "Karaoke songs with lyrics", 7 per page
# picks: songs people added to a party queue, most picked first, 7 per page
POPULAR_SOURCE=youtube

# Close rooms (and their queue) after this many hours with 0 connected users
ROOM_IDLE_HOURS=2

# Shared secret for /admin usage stats (send as x-admin-secret header)
ADMIN_SECRET=change-me-to-a-long-random-string

# Public Google Identity Services client id (Sign in with Google).
# Use the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Do not put a client secret here or in the frontend.
GOOGLE_CLIENT_ID=

# Gmail SMTP for account confirmation and password reset.
# Use an App Password, not your normal Gmail password. See the setup notes in the project chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=TaraSing <you@gmail.com>
# Links inside account emails
APP_URL=http://localhost:3000

# Set to null for in-memory storage, or a MySQL URL (e.g. mysql://user:pass@localhost:3306/online_karaoke)
# Accounts, favorites, and playlists need MySQL. Parties still work when this is null.
DB_URL=null
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=online_karaoke
