PORT=4000
# Comma-separated OK. www / non-www variants are added automatically.
CLIENT_URL=http://localhost:3000,https://tarasing.online,https://www.tarasing.online

# Use one Google Cloud project for YouTube API (production). Do not spread keys across projects.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Close rooms (and their queue) after this many hours with 0 connected users
ROOM_IDLE_HOURS=2

# Shared secret for /admin usage stats (send as x-admin-secret header)
ADMIN_SECRET=change-me-to-a-long-random-string

# Set to null for in-memory storage, or a MySQL URL (e.g. mysql://user:pass@localhost:3306/online_karaoke)
DB_URL=null
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=online_karaoke
