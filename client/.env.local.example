NEXT_PUBLIC_API_URL=http://localhost:4000
# Public Google Identity Services client id. Same value as server GOOGLE_CLIENT_ID.
# This is not a secret. Do not put a Google client secret in frontend env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=https://www.tarasing.online
# Public contact email shown on Terms / Privacy / footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@tarasing.online
# When true, guests see a muted YouTube player synced to the host
NEXT_PUBLIC_ENABLE_GUEST_VIDEO=false
# How many songs a guest's browser keeps in its on-device history
NEXT_PUBLIC_SONG_HISTORY_LIMIT=50
